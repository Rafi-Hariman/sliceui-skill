{
  "name": "sliceui-skill",
  "version": "0.15.0",
  "description": "Agent skill + CLI: convert UI designs (Figma XML or screenshots) into idiomatic component code. Angular-first (v13); React/Vue/Svelte/Next/Tailwind detection + syntax rules are experimental and not verify-gated.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sliceui": "src/cli.mjs"
  },
  "files": [
    "src/",
    "!src/framework/angular/pilar-*.mjs",
    "!src/framework/angular/uii-profile.mjs",
    "!src/framework/angular/uii-slice-policy.mjs",
    "!src/lib/pilar-version.mjs",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "skill",
    "agent",
    "ai",
    "screenshot-to-code",
    "image-to-code",
    "angular",
    "frontend"
  ],
  "scripts": {
    "test": "node --test test/",
    "prepublishOnly": "npm test && node scripts/guard-publish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rafi-Hariman/sliceui-skill.git"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.11.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0",
    "sass": "^1.80.0"
  }
}
