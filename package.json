{
  "name": "sliceui-skill",
  "version": "0.12.0",
  "description": "Agent skill + CLI: convert UI designs (Figma XML or screenshots) into idiomatic component code that matches your project's framework and UI libraries (Angular 13, React, Vue, Svelte, Next.js, Tailwind, Bootstrap, HTML).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sliceui": "src/cli.mjs"
  },
  "files": [
    "src/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "skill",
    "agent",
    "ai",
    "screenshot-to-code",
    "image-to-code",
    "angular",
    "frontend"
  ],
  "scripts": {
    "test": "node --test test/",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rafi-Hariman/sliceui-skill.git"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.11.1",
    "typescript": "^5.9.2"
  }
}
